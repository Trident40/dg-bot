{
  "$schema": "https://github.com/arcane-mp/foundations/dg-discord.schema.json",
  "enabled": true,
  "serverDisplayName": "Hogwarts ArcaneMP RP",
  "rootAdminDiscordIds": [
    "ADMINDISCORDIDHERE"
  ],
  "bridge": {
    "host": "127.0.0.1",
