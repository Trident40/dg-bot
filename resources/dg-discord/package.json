{
  "name": "dg-discord",
  "version": "1.0.0",
  "private": true,
  "author": "ArcaneMP Server Developer",
  "description": "ArcaneMP Foundations Discord Bridge — Authenticated HTTP/SSE bridge + MySQL offline action queue + Hogwarts House role sync & audit exporter.",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.js --legal-comments=inline",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "clientScripts": [],
    "files": [],
    "exports": [
      "pushAudit",
      "syncPlayerRoles",
      "getLinkedDiscordId",
      "getBridgeStatus"
    ],
    "resourceDependencies": [
      {
        "name": "hmp-lib",
        "version": "0.12.0"
      },
      {
        "name": "hmp-core",
        "version": "0.12.0"
      }
    ],
    "errorBehavior": "stop",
    "priority": -850
  }
}