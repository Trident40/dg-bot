{
  "name": "dg-discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Discord.js v14 bot for dg-discord (ArcaneMP Foundations)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js --packages=external",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}